---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import profilePicture from '../assets/me.jpeg';
import cv from '../assets/Arthur_Font_Gouveia_CV.pdf';

const experience = [
  { period: 'Sep 2026 - Present', role: 'Backend Software Developer', place: 'Leaf Space' },
  { period: 'Dec 2024 - Oct 2025', role: 'Software Engineer', place: 'Cubbo' },
  { period: 'Nov 2022 - Oct 2025', role: 'Junior Full Stack Engineer', place: 'Cubbo' },
  { period: 'Oct 2021 - Feb 2022', role: 'Salesforce B2C Commerce Developer', place: 'Capgemini' },
  { period: 'Sep 2019 - Jul 2020', role: 'Collaborative Scholarship in Information Technology', place: 'University of Barcelona' },
];

const education = [
  { period: '2025 - Present', role: "Master's in Computer Science (Distributed Systems and Networks)", place: 'University of Bologna' },
  { period: '2018 - 2022', role: "Bachelor's in Computer Engineering", place: 'University of Barcelona' },
];

const languages = [
  'Portuguese - Native (C2)',
  'Spanish - Proficient (C2)',
  'English - Advanced (C1)',
  'Catalan - Advanced (C1)',
  'Italian - Upper-intermediate (B2)',
];
---

<Layout title="About | Arthur Font" description="Background, experience, education and contact details of Arthur Font, software engineer.">
  <article class="about-page">
    <header class="about-hero">
      <Image src={profilePicture} alt="Portrait of Arthur Font" class="avatar" />
      <div class="hero-text">
        <h1>Hi, I'm Arthur</h1>
        <p class="lead">I am a Software Engineer currently pursuing a Master's degree in Computer Science at the University of Bologna. I hold a Bachelor's degree in Computer Engineering from the University of Barcelona and speak English, Spanish, Portuguese, Catalan, and Italian.</p>
        <p class="lead">Born in Brazil and a Spanish citizen, I enjoy working in international environments. Beyond tech, my life is all about travel and sports, so there's a good chance you'll catch me out surfing or playing footvolley.</p>
        <p class="lead">I am always eager to connect, collaborate on exciting tech projects, and explore career opportunities.</p>
        <p>Curriculum Vitae: <a href={cv} target="_blank" rel="noopener noreferrer">PDF</a></p>
      </div>
    </header>

    <section>
      <h2>Experience</h2>
      <div class="items">
        {experience.map(({ period, role, place }) => (
          <div class="item">
            <p class="period">{period}</p>
            <p><strong>{role}</strong> - {place}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Education</h2>
      <div class="items">
        {education.map(({ period, role, place }) => (
          <div class="item">
            <p class="period">{period}</p>
            <p><strong>{role}</strong> - {place}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Languages</h2>
      <ul>
        {languages.map(language => <li>{language}</li>)}
      </ul>
    </section>

    <section>
      <h2>Citizenship</h2>
      <p>Spanish / Brazilian citizen</p>
    </section>

    <section>
      <h2>Hobbies</h2>
      <p>Surfing, footvolley, soccer and traveling</p>
    </section>

    <section>
      <h2>Contact me</h2>
        <p>Email: <a href="mailto:arthurfont2000@gmail.com">arthurfont2000@gmail.com</a></p>
        <p>Phone: <a href="tel:+393520180722">+39 352 018 0722</a></p>      
      </section>
  </article>

  <style>
    .about-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1rem;
      line-height: 1.6;
    }
    .about-hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      margin: 1rem 0;
    }
    /* Don't crop the image: keep aspect ratio and show whole image */
    .avatar {
      border-radius: 25px;
    }

    .hero-text {
      background-color: var(--gray-900);
      padding: 1rem 1.5rem;
      border-radius: 25px;
    }

    h1 { 
        font-size: var(--text-3xl);
    }

    .period { font-size: var(--text-sm); color: var(--gray-400); margin: 0 } 
    
    .item {
        margin-bottom: 0.5rem;
    }

    p {
        margin: 0;
    }

    .lead { margin: 1rem 0; }

    /* Section spacing */
    section { 
        margin: 0; 
        padding: 1rem 1.5rem; 
        border-radius: 25px;
        margin: 1rem 0;
    }

    section h2 { 
        margin: 0 0 0.5rem 0; 
        font-size: var(--text-2xl);
    }

    ul { margin: 0; padding-left: 1.25rem; }
    li { margin: 2px 0; }

    section {
      background: var(--gray-900);
    }

    a { color: var(--link-color); }

    @media (min-width: 640px) {
      .about-hero { flex-direction: row;}
      .about-page { padding: 0 0; margin: 1rem auto;}
    }

  </style>
</Layout>
