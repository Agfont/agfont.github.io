---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { sortWork, toWorkItem } from '../utils/work';

const sortedWork = sortWork((await getCollection('work')).map(toWorkItem), 'relevance');
---

<Layout title="Work | Arthur Font" description="Projects by Arthur Font across web development, AI & ML, data science and remote sensing.">
  <div class="container">
    <h1 class="heading">Some of my best work</h1>
    <work-filter data-work={JSON.stringify(sortedWork)}>
      <FilterBar />
      <div id="work-items-grid" class="work-grid">
        {sortedWork.map(project => <WorkCard project={project} />)}
      </div>
      <p id="no-results" class="no-results" role="status" hidden>No projects match your filters.</p>
    </work-filter>
  </div>
</Layout>

<script>
  import { sortWork, type WorkItem, type WorkSort } from '../utils/work';

  class WorkFilter extends HTMLElement {
    private abort = new AbortController();

    connectedCallback() {
      const items = JSON.parse(this.dataset.work || '[]') as WorkItem[];
      const grid = this.querySelector('#work-items-grid') as HTMLElement;
      const noResults = this.querySelector('#no-results') as HTMLElement;
      const input = this.querySelector('#search-input') as HTMLInputElement;
      const tagCount = this.querySelector('#tag-count') as HTMLElement;
      const techCount = this.querySelector('#tech-count') as HTMLElement;
      const sortLabel = this.querySelector('#sort-label') as HTMLElement;
      const dropdowns = Array.from(this.querySelectorAll<HTMLElement>('.custom-dropdown'));
      const tagItems = Array.from(this.querySelectorAll<HTMLElement>('.tag-item'));
      const techItems = Array.from(this.querySelectorAll<HTMLElement>('.tech-item'));
      const sortItems = Array.from(this.querySelectorAll<HTMLElement>('.sort-item'));
      const cardMap = new Map(
        Array.from(this.querySelectorAll<HTMLElement>('.work-card')).map(c => [c.dataset.id, c])
      );

      // Restore state from the URL
      const params = new URLSearchParams(window.location.search);
      let tags = params.get('tags')?.split(',').filter(Boolean) ?? [];
      let techs = params.get('tech')?.split(',').filter(Boolean) ?? [];
      const sortParam = params.get('sort');
      let sort = (sortItems.some(el => el.dataset.sort === sortParam) ? sortParam : 'relevance') as WorkSort;
      input.value = params.get('search') || '';

      const setActive = (el: HTMLElement, active: boolean) => {
        el.classList.toggle('active', active);
        el.setAttribute('aria-checked', String(active));
      };

      const setOpen = (dropdown: HTMLElement, open: boolean) => {
        dropdown.classList.toggle('open', open);
        dropdown.querySelector('.dropdown-trigger')!.setAttribute('aria-expanded', String(open));
      };

      const update = () => {
        const search = input.value.trim().toLowerCase();

        const p = new URLSearchParams();
        if (tags.length) p.set('tags', tags.join(','));
        if (techs.length) p.set('tech', techs.join(','));
        if (sort !== 'relevance') p.set('sort', sort);
        if (search) p.set('search', input.value.trim());
        const query = p.toString();
        window.history.replaceState({}, '', (query ? `?${query}` : location.pathname) + location.hash);

        tagItems.forEach(el => setActive(el, tags.includes(el.dataset.tag!)));
        techItems.forEach(el => setActive(el, techs.includes(el.dataset.tech!)));
        sortItems.forEach(el => {
          setActive(el, el.dataset.sort === sort);
          if (el.dataset.sort === sort) sortLabel.textContent = el.textContent;
        });
        tagCount.textContent = tags.length ? `(${tags.length})` : '';
        techCount.textContent = techs.length ? `(${techs.length})` : '';

        const filtered = items.filter(i => {
          const hay = [i.title, i.description, ...i.fields, ...i.technologies].map(s => s.toLowerCase());
          return (!search || hay.some(s => s.includes(search)))
            && (!tags.length || tags.some(t => i.fields.includes(t)))
            && (!techs.length || techs.some(t => i.technologies.includes(t)));
        });

        const visible = new Set(filtered.map(i => i.id));
        cardMap.forEach((card, id) => (card.hidden = !visible.has(id!)));
        sortWork(filtered, sort).forEach(i => grid.appendChild(cardMap.get(i.id)!));
        noResults.hidden = filtered.length > 0;
      };

      const toggle = (list: string[], value: string) =>
        list.includes(value) ? list.filter(x => x !== value) : [...list, value];

      const { signal } = this.abort;

      this.addEventListener('click', e => {
        const target = e.target as HTMLElement;
        const trigger = target.closest<HTMLElement>('.dropdown-trigger');
        const tagItem = target.closest<HTMLElement>('.tag-item');
        const techItem = target.closest<HTMLElement>('.tech-item');
        const sortItem = target.closest<HTMLElement>('.sort-item');

        if (trigger) {
          // Only one dropdown open at a time
          const dropdown = trigger.parentElement!;
          const open = !dropdown.classList.contains('open');
          dropdowns.forEach(d => setOpen(d, d === dropdown && open));
        } else if (tagItem) {
          tags = toggle(tags, tagItem.dataset.tag!);
          update();
        } else if (techItem) {
          techs = toggle(techs, techItem.dataset.tech!);
          update();
        } else if (sortItem) {
          sort = sortItem.dataset.sort as WorkSort;
          update();
        }
      }, { signal });

      // Close dropdowns on outside click or Escape
      document.addEventListener('click', e => {
        if (!(e.target as HTMLElement).closest('.custom-dropdown')) dropdowns.forEach(d => setOpen(d, false));
      }, { signal });
      this.addEventListener('keydown', e => {
        const open = dropdowns.find(d => d.classList.contains('open'));
        if (e.key === 'Escape' && open) {
          setOpen(open, false);
          open.querySelector<HTMLElement>('.dropdown-trigger')!.focus();
        }
      }, { signal });

      input.addEventListener('input', update, { signal });
      update();
    }

    disconnectedCallback() {
      this.abort.abort();
      this.abort = new AbortController();
    }
  }
  customElements.define('work-filter', WorkFilter);
</script>

<style>
  .container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding: 0.5rem 1rem 1rem 1rem;
  }
  .heading {
    font-size: var(--text-xl);
    margin-bottom: 2rem;
    font-weight: 600;
    text-align: center;
    color: var(--gray-0);
  }
  .no-results {
    text-align: center;
    color: var(--gray-400);
    margin: 2rem 0;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .heading { font-size: var(--text-2xl); margin-bottom: 3rem; }
    .container { padding: 1rem 1rem; }
  }
  @media (min-width: 1024px) {
    .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>